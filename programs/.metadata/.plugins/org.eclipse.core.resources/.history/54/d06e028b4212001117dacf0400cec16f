//ADCのDAM割り込み！
void HAL_ADC_ConvCpltCallback(ADC_HandleTypeDef* hadc)
{
    if (hadc->Instance == ADC1) {
    	//オフセット検出モードか、電流センシングモードか
    	if(offset_done_flag == false){
    		adc_offset[0] += adc_raw[0];
    		adc_offset[1] += adc_raw[1];
    		adc_offset[2] += adc_raw[2];

    		offset_count++;

    		if(offset_count >= offset_ave_num){
				adc_offset[0] = adc_offset[0] / offset_ave_num;
				adc_offset[1] = adc_offset[1] / offset_ave_num;
				adc_offset[2] = adc_offset[2] / offset_ave_num;
    			offset_done_flag = true;
    		}
    	}
    	else{
    		//(3.3 / 4096.0)) / 0.05 = 0.01611
    		I_u = (float)(adc_raw[2] - adc_offset[2]) * 0.01611;
    		I_v = (float)(adc_raw[1] - adc_offset[1]) * 0.01611;
    		I_w = (float)(adc_raw[0] - adc_offset[0]) * 0.01611;
    		I_sum = I_u + I_v + I_w;
    	}
    }
}

//clarke変換
void clarke_transform(){
	Ia = I_u;
	Ib = (I_u + 2 * I_v) / sqrtf(3.0);
}

//park変換
void park_transform(){
	Id = Ia * degree_e_cos + Ib * degree_e_sin;
	Iq = -Ia * degree_e_sin + Ib * degree_e_cos;

	Id_PI.now_value = Id;
	Iq_PI.now_value = Iq;
}

//逆clarke変換
void inv_clarke_transform(){
	U_PWM = (int)Va;
	V_PWM = (int)((sqrtf(3.0) * Vb - Va) / 2);
	W_PWM = (int)((-sqrtf(3.0) * Vb - Va) / 2);
}

//逆park変換
void inv_park_transform(){
	Va = Vd * degree_e_cos - Vq * degree_e_sin;
	Vb = Vd * degree_e_sin + Vq * degree_e_cos;
}

//PI制御
float PI_Control(PI_t *hPI){
	hPI->error = hPI->goal - hPI->now_value;
	hPI->error_integral += hPI->error * hPI->ki;

	// アンチワインドアップ（本体を直接制限する）
	if(hPI->error_integral > hPI->integral_limit){
		hPI->error_integral = hPI->integral_limit;
	}
	else if(hPI->error_integral < -hPI->integral_limit){
		hPI->error_integral = -hPI->integral_limit;
	}

	return (hPI->kp * hPI->error + hPI->error_integral);
}

