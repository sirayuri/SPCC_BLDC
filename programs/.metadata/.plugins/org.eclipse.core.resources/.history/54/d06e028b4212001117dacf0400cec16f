int constrain(int num, int min, int max){
	if(num > max){
		return max;
	}
	else if(min > num){
		return min;
	}
	else{
		return num;
	}
}

float constrainf(float num, float min, float max){
	if(num > max){
		return max;
	}
	else if(min > num){
		return min;
	}
	else{
		return num;
	}
}

