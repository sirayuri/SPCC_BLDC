/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */
  setbuf(stdout, NULL);
  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_DMA_Init();
  MX_ADC1_Init();
  MX_TIM3_Init();
  MX_USART1_UART_Init();
  MX_TIM2_Init();
  MX_TIM1_Init();
  /* USER CODE BEGIN 2 */

  /*	前処理スタート	*/

  //全IR2302をロック(安全のため！)
  HAL_GPIO_WritePin(U_SD_GPIO_Port, U_SD_Pin, RESET);
  HAL_GPIO_WritePin(V_SD_GPIO_Port, V_SD_Pin, RESET);
  HAL_GPIO_WritePin(W_SD_GPIO_Port, W_SD_Pin, RESET);

  //ADCのキャリブレーション
  HAL_ADCEx_Calibration_Start(&hadc1, ADC_SINGLE_ENDED);

  //PWMスタート
  HAL_TIM_PWM_Start(&MOTOR_PWM_TIMER, U_PHASE_PWM_CHANNEL);
  HAL_TIM_PWM_Start(&MOTOR_PWM_TIMER, V_PHASE_PWM_CHANNEL);
  HAL_TIM_PWM_Start(&MOTOR_PWM_TIMER, W_PHASE_PWM_CHANNEL);

  //全IR2302のロックを解除
  HAL_GPIO_WritePin(U_SD_GPIO_Port, U_SD_Pin, SET);
  HAL_GPIO_WritePin(V_SD_GPIO_Port, V_SD_Pin, SET);
  HAL_GPIO_WritePin(W_SD_GPIO_Port, W_SD_Pin, SET);

  //回転を固定
  SET_PWM_DUTY(U, 500);
  SET_PWM_DUTY(V, 500);
  SET_PWM_DUTY(W, 500);

  //ADCをDMAモードで待機！
  if (HAL_ADC_Start_DMA(&hadc1, (uint32_t*)adc_raw, 3) != HAL_OK)
  {
	  Error_Handler();
  }

  while(offset_done_flag == false){
	  //オフセット電圧検出待ち...
  }

  /*	電気角のリセット	*/

  //電流方向U->Vのときを電気角0[rad]と定義
  SET_PWM_DUTY(U, 300);
  SET_PWM_DUTY(V, 0);
  SET_PWM_DUTY(W, 0);

  //固定待ち...
  HAL_Delay(2000);

  //0カウントをセット
  __HAL_TIM_SET_COUNTER(&htim2, 0);

  //エンコーダースタート！
  HAL_TIM_Encoder_Start(&htim2, TIM_CHANNEL_ALL);

  //全IR2302のロックを解除
  HAL_GPIO_WritePin(U_SD_GPIO_Port, U_SD_Pin, SET);
  HAL_GPIO_WritePin(V_SD_GPIO_Port, V_SD_Pin, SET);
  HAL_GPIO_WritePin(W_SD_GPIO_Port, W_SD_Pin, SET);

  //回転を固定
  SET_PWM_DUTY(U, 500);
  SET_PWM_DUTY(V, 500);
  SET_PWM_DUTY(W, 500);

  //制御用タイマ割り込みスタート
  HAL_TIM_Base_Start_IT(&htim1);
  __HAL_TIM_ENABLE_IT(&htim3, TIM_IT_UPDATE);
  /*	FOCスタート		*/

  //d軸電流のパラメータを設定
  Id_PI.goal = 0.0;
  Id_PI.kp = 0.5;
  Id_PI.ki = 10;
  Id_PI.integral_limit = 200;

  //q軸電流のパラメータを設定
  Iq_PI.goal = 1;
  Iq_PI.kp = 0.5;
  Iq_PI.ki = 10;
  Iq_PI.integral_limit = 200;

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */

	  /*	現在のカウントを取得	*/
	  cnt_now = 20479 - __HAL_TIM_GET_COUNTER(&htim2);
//	  cnt_now = __HAL_TIM_GET_COUNTER(&htim2);

	  /*	ラジアン角を算出して、ついでに電気角も算出！	*/
	  degree = (float)(cnt_now / 20480.0) * 2 * M_PI;
	  degree_e = (float)degree * (float)pole_pairs;
	  degree_e_sin = sinf(degree_e);
	  degree_e_cos = cosf(degree_e);

	  //10kHzの割り込み
	  if(tim3_flag){
		  //Iu,Iv,Iw -> Iα,Iβ
		  clarke_transform();
		  //Iα,Iβ -> Id,Iq
		  park_transform();

		  //Id,IqをPI制御
		  Vd = PI_Control(&Id_PI);
		  Vq = PI_Control(&Iq_PI);

		  //Vd,Vq -> Vα,Vβ
		  inv_park_transform();
		  //Vα,Vβ -> Vu,Vv,Vw
		  inv_clarke_transform();

		  U_PWM = constrain(U_PWM, -Amp_PWM_MAX, Amp_PWM_MAX);
		  V_PWM = constrain(V_PWM, -Amp_PWM_MAX, Amp_PWM_MAX);
		  W_PWM = constrain(W_PWM, -Amp_PWM_MAX, Amp_PWM_MAX);

		  //PWMをセット
		  SET_PWM_DUTY(U, 500 + U_PWM);
		  SET_PWM_DUTY(V, 500 + V_PWM);
		  SET_PWM_DUTY(W, 500 + W_PWM);

		  tim3_flag = false;
	  }
  }
  /* USER CODE END 3 */
}

