/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */
	setbuf(stdout, NULL);
  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_DMA_Init();
  MX_ADC1_Init();
  MX_TIM3_Init();
  MX_USART1_UART_Init();
  MX_TIM2_Init();
  MX_TIM1_Init();
  /* USER CODE BEGIN 2 */
  /* USER CODE BEGIN 2 */
    HAL_TIM_PWM_Start(&MOTOR_PWM_TIMER, U_PHASE_PWM_CHANNEL);
    HAL_TIM_PWM_Start(&MOTOR_PWM_TIMER, V_PHASE_PWM_CHANNEL);
    HAL_TIM_PWM_Start(&MOTOR_PWM_TIMER, W_PHASE_PWM_CHANNEL);
  //0カウントをセット
  __HAL_TIM_SET_COUNTER(&htim2, 0);

  //エンコーダースタート！
  HAL_TIM_Encoder_Start(&htim2, TIM_CHANNEL_ALL);
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
	  drive_120degree(count, 100);
	  HAL_Delay(40);
	  count++;

	  /*	現在のカウントを取得	*/
	  cnt_now = 20479 - __HAL_TIM_GET_COUNTER(&htim2);
//	  cnt_now = __HAL_TIM_GET_COUNTER(&htim2);

	  /*	ラジアン角を算出して、ついでに電気角も算出！	*/
	  degree = (float)(cnt_now / 20480.0) * 2 * M_PI;
	  degree_e = (float)degree * (float)pole_pairs;
	  degree_e_sin = sinf(degree_e);
	  degree_e_cos = cosf(degree_e);

	  printf("%f %f %f\r\n", degree_e, degree_e_sin, degree_e_cos);
  }
  /* USER CODE END 3 */
}

