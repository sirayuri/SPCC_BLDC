void drive_120degree(int step, int duty) {

    // 1. まず全相を一旦High-Z（SDピンをLOW、PWMを0）にして貫通電流を確実に防ぐ
    HAL_GPIO_WritePin(U_SD_GPIO_Port, U_SD_Pin, RESET);
    HAL_GPIO_WritePin(V_SD_GPIO_Port, V_SD_Pin, RESET);
    HAL_GPIO_WritePin(W_SD_GPIO_Port, W_SD_Pin, RESET);

    SET_PWM_DUTY(U, 0);
    SET_PWM_DUTY(V, 0);
    SET_PWM_DUTY(W, 0);

    // 2. ステップ(0〜5)に応じた通電パターンの適用
    // 流入(High側)にdutyを与え、流出(Low側)を0(ローサイドON)にする
    switch(step % 6) {
        case 0: // UからVへ電流を流す (Wは休み)
            SET_PWM_DUTY(U, duty); // UハイサイドON
            SET_PWM_DUTY(V, 0);    // VローサイドON
            HAL_GPIO_WritePin(U_SD_GPIO_Port, U_SD_Pin, SET);
            HAL_GPIO_WritePin(V_SD_GPIO_Port, V_SD_Pin, SET);
            break;

        case 1: // UからWへ
            SET_PWM_DUTY(U, duty);
            SET_PWM_DUTY(W, 0);
            HAL_GPIO_WritePin(U_SD_GPIO_Port, U_SD_Pin, SET);
            HAL_GPIO_WritePin(W_SD_GPIO_Port, W_SD_Pin, SET);
            break;

        case 2: // VからWへ
            SET_PWM_DUTY(V, duty);
            SET_PWM_DUTY(W, 0);
            HAL_GPIO_WritePin(V_SD_GPIO_Port, V_SD_Pin, SET);
            HAL_GPIO_WritePin(W_SD_GPIO_Port, W_SD_Pin, SET);
            break;

        case 3: // VからUへ
            SET_PWM_DUTY(V, duty);
            SET_PWM_DUTY(U, 0);
            HAL_GPIO_WritePin(V_SD_GPIO_Port, V_SD_Pin, SET);
            HAL_GPIO_WritePin(U_SD_GPIO_Port, U_SD_Pin, SET);
            break;

        case 4: // WからUへ
            SET_PWM_DUTY(W, duty);
            SET_PWM_DUTY(U, 0);
            HAL_GPIO_WritePin(W_SD_GPIO_Port, W_SD_Pin, SET);
            HAL_GPIO_WritePin(U_SD_GPIO_Port, U_SD_Pin, SET);
            break;

        case 5: // WからVへ
            SET_PWM_DUTY(W, duty);
            SET_PWM_DUTY(V, 0);
            HAL_GPIO_WritePin(W_SD_GPIO_Port, W_SD_Pin, SET);
            HAL_GPIO_WritePin(V_SD_GPIO_Port, V_SD_Pin, SET);
            break;
    }
}

